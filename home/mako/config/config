# ======================================
# Global
# ======================================

sort=-time
max-history=20
history=1
actions=1
markup=1

font=JetBrainsMono Nerd Font 11
format=<b>%s</b>\n%b
text-alignment=left

width=320
height=200
outer-margin=10
margin=5
padding=10,16
border-size=2
border-radius=4
border-color=#4C7899FF
background-color=#1a1a1aee
text-color=#eeeeee
progress-color=over #5588AAFF

icons=1
max-icon-size=64
icon-location=left

layer=overlay
anchor=top-right
max-visible=5

default-timeout=5000
ignore-timeout=0

on-button-left=invoke-default-action
on-button-middle=dismiss-group
on-button-right=dismiss
on-touch=invoke-default-action

# ======================================
# Urgency
# ======================================

[urgency=low]
border-color=#555555ff
text-color=#aaaaaa
default-timeout=3000

[urgency=normal]
border-color=#4C7899FF

[urgency=critical]
border-color=#cc4444ff
background-color=#2a1010ee
default-timeout=0

# ======================================
# Do Not Disturb
# ======================================

[mode=do-not-disturb]
invisible=1

# ======================================
# Hidden Overflow Placeholder
# ======================================

[hidden=true]
format=(%h more)
invisible=0

# ======================================
# Grouped Notification
# ======================================

[grouped]
format=(%g) <b>%s</b>\n%b
